# ==============================================================================
# Flavours of India — Environment Configuration Template
# Production & Staging Environment Variables (Names only, no real values)
# ==============================================================================

# Supabase Production Configuration (Required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public Site URL & Session Security
PUBLIC_SITE_URL=http://localhost:3000
SESSION_SECRET=your-random-session-secret

# External Transactional Messaging Adapters (Optional)
EMAIL_PROVIDER_API_KEY=
SMS_PROVIDER_API_KEY=

# Optional S3/Object Storage Overrides (Default uses Supabase Storage)
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_REGION=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=

# Google Sheet Automated Order/Lead Sync Webhook
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/your-google-script-id/exec

# Port configuration
PORT=3000
NODE_ENV=development
